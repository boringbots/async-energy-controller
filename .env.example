# Async Energy controller — environment
#
# Every value is OPTIONAL at import: the package constructs with this file empty
# (the empty-environment policy — never block on missing credentials). The ApiClient
# only needs these at the point it actually talks to the API. Filling them in is a
# manual, post-credentials step, never a test prerequisite.

# --- optimizer API endpoint ---
# Base URL of the Async Energy optimizer API this controller reports to.
#   production: https://api.async.energy   (local dev: http://localhost:8000)
HM_ASYNC_API_URL=https://api.async.energy

# --- owner credentials (the controller authenticates as its owner) ---
# Email + password of the Async Energy account that owns this box's workflows.
# Sign up at https://async.energy/quickstart/ — the controller logs in against
# the API's /auth/login proxy and refreshes its JWT automatically.
HM_ASYNC_EMAIL=
HM_ASYNC_PASSWORD=

# --- controller identity ---
# Stable id for this box; half of the server-side (controller_id, run_id)
# idempotency key. Leave empty to default to the machine hostname.
CONTROLLER_ID=

# --- the local job catalog ---
# Path to the JSON file mapping workflow ids to what THIS box runs. Relative
# paths resolve against the controller's working directory. `--job-catalog PATH`
# overrides this, and a real exported environment variable overrides this file.
# HM_ASYNC_JOB_CATALOG=jobs.json

# --- optional overrides (sensible defaults; usually leave unset) ---
# Path to the single-file SQLite offline spool.
# SPOOL_PATH=hmasync_spool.db
# Per-request HTTP timeout in seconds.
# HTTP_TIMEOUT_S=10.0

# --- the library shape (sdk.AsyncEnergy) ---
# An API key minted in the dashboard (https://async.energy/app/keys/), sent as
# X-API-Key. Used by `AsyncEnergy()` when no api_key= is passed; the daemon
# above authenticates with the owner credentials instead.
# HM_ASYNC_API_KEY=

# --- community benchmark (all optional; nothing is sent until you opt in) ---
# Share measured benchmark data. Set ONLY via `async-energy-controller bench
# opt-in`, which prints the consent text first and writes this line for you;
# `bench opt-out` reverts it. Gates every bench upload.
# BENCH_OPTIN=false
# Where `bench quick` writes its dated bundle files (submission-shaped rollups).
# BENCH_BUNDLE_DIR=bench_bundles
# Where each measured task's raw artifacts land (telemetry.parquet, items.parquet,
# metrics.json) — the only durable record of a run's raw telemetry.
# BENCH_DATA_DIR=bench_data
# Offline spool for bench submissions, separate from the run-report spool so a
# stuck submission never blocks a run report.
# BENCH_SPOOL_PATH=hmasync_bench_spool.db
# This box's random identity seed: generated once, never transmitted; only its
# hash (node_hash) leaves the box. Bench registration and the power cap must
# use the SAME salt file.
# NODE_SALT_PATH=hmasync_node_salt

# --- power cap (a separate consent from BENCH_OPTIN; neither implies the other) ---
# When true and the box has an NVML GPU, apply this node's server-recommended
# power cap around each scheduled GPU job and restore it afterwards. No
# recommendation yet, or no permission to set one, is never an error.
# APPLY_POWER_CAP=false
# Who owns the GPU's power limit: "preserve" puts back the exact limit found
# (a cap you set yourself survives; a cap left by a killed job also survives,
# warned about on every job); "managed" restores the card's factory default.
# POWER_CAP_POLICY=preserve
