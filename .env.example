# Async Energy controller — environment
#
# Every value is OPTIONAL at import: the package constructs with this file empty
# (the empty-environment policy — never block on missing credentials). The ApiClient
# only needs these at the point it actually talks to the API. Filling them in is a
# manual, post-credentials step, never a test prerequisite.

# --- optimizer API endpoint ---
# Base URL of the Async Energy optimizer API this controller reports to.
#   production: https://api.async.energy   (local dev: http://localhost:8000)
HM_ASYNC_API_URL=https://api.async.energy

# --- owner credentials (the controller authenticates as its owner) ---
# Email + password of the Async Energy account that owns this box's workflows.
# Sign up at https://async.energy/quickstart/ — the controller logs in against
# the API's /auth/login proxy and refreshes its JWT automatically.
HM_ASYNC_EMAIL=
HM_ASYNC_PASSWORD=

# --- controller identity ---
# Stable id for this box; half of the server-side (controller_id, run_id)
# idempotency key. Leave empty to default to the machine hostname.
CONTROLLER_ID=

# --- the local job catalog ---
# Path to the JSON file mapping workflow ids to what THIS box runs. Relative
# paths resolve against the controller's working directory. `--job-catalog PATH`
# overrides this, and a real exported environment variable overrides this file.
# HM_ASYNC_JOB_CATALOG=jobs.json

# --- optional overrides (sensible defaults; usually leave unset) ---
# Path to the single-file SQLite offline spool.
# SPOOL_PATH=hmasync_spool.db
# Per-request HTTP timeout in seconds.
# HTTP_TIMEOUT_S=10.0
