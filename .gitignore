# Secrets and per-box config — NEVER commit these.
.env
jobs.json
*.db
*.sqlite
*.sqlite3

# What a bench run drops in the working tree. The README tells people to run
# `bench quick` from inside this clone, so these land in a PUBLIC repo unless
# they are ignored here. The salt is the one that matters most: node_hash is
# salted with it precisely so a submitted config cannot be reversed to a
# specific machine, and committing the salt undoes that for every submission
# this box has ever sent.
hmasync_node_salt
bench_bundles/
bench_data/
# Reference weights. `bench reference` tells people to download the pinned
# GGUF into ./ref, which is 5.2 GB of model sitting in the working tree of a
# repo that IS the public distribution -- ignored so the documented command
# cannot end up as a commit.
ref/
*.gguf
# What `scripts/run-prism-wave-mac.sh` drops: the fork's prebuilt llama-server,
# 23 GB of Bonsai weights, and one server log per rung. Same reason as ref/ --
# the documented command must not be able to become a commit.
prism-mac/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Marker dropped by the upstream export script so it knows this tree is a
# previous export and safe to regenerate. Must exist on disk, must never be
# committed.
.async-energy-export

# --- Internal, never publish -------------------------------------------------
# This directory is BOTH the working tree and the thing that gets pushed to a
# public repo, so anything dropped in here is one `git add -A` away from being
# public. Keep internal material behind these patterns, and run
# `git status --short` before committing.
# (Patterns only — git does NOT strip trailing comments, so a note on the same
# line becomes part of the pattern and silently stops it matching.)
#
# user/integration feedback and review notes:
*-feedback.md
# local push instructions / credential reminders:
PUBLISHING.md
# scratch space for anything not meant to ship:
/private/
/scratch/

# Local agent/loop scaffolding — never commit (this repo is public)
CLAUDE.md
prd.json
progress.txt
ralph.sh
# every .ralph-* file and directory: logs, archive, and the last-branch marker
.ralph-*
.venv-linux/
# Root-level PRD-markdown scratch dir only — anchored so it does NOT also
# match hmasync_controller/bench/tasks/, the real shipped task-registry code
# (US-MERGE-01 discrepancy: this pattern used to be bare `tasks/`, which is
# unanchored and would have silently hidden that package from git).
/tasks/
# Archive-only prism bundles (see prism-results/README.md) -- they belong on
# the share drive, not in a public repo.
prism-results/
prism-models/
